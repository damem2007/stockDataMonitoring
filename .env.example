# Supabase/Postgres persistence. Copy this file to .env and use your real
# Supabase connection string and private local root password there.
DATABASE_URL=postgresql://postgres:<password>@<project-ref>.supabase.co:5432/postgres
CORS_ALLOWED_ORIGINS=http://localhost:8520,http://192.168.1.67:8520,http://192.168.1.67:8520

AUTH_MODE=hybrid
JWT_SECRET=<replace-with-a-new-strong-secret>
JWT_ALGORITHM=HS256
JWT_ISSUER=stock-signal-local
JWT_AUDIENCE=stock-signal-api
JWT_ACCESS_TOKEN_MINUTES=60

LOCAL_ROOT_EMAIL=root@stock-signal.local
LOCAL_ROOT_USERNAME=root
LOCAL_ROOT_NAME=Local Root Administrator
LOCAL_ROOT_PASSWORD=<replace-with-a-private-password>

ANALYSIS_REQUIRE_REDIS=false
ANALYSIS_JOB_STALE_SECONDS=7200
# OpenAI is the preferred interpretation provider. Local calculations build
# the evidence baseline and are the final fallback when OpenAI is unavailable.
AI_DISCLOSURE=OpenAI-assisted investment research is being used. This is educational decision support, not financial advice.
LOCAL_DISCLOSURE=Deterministic local calculations are being used as the final fallback. This is educational decision support, not financial advice.
RECOMMENDED_OPENAI_MODEL=gpt-5.6-sol
OPENAI_RESPONSES_ENDPOINT=https://api.openai.com/v1/responses
OPENAI_CONNECT_TIMEOUT_SECONDS=10
OPENAI_READ_TIMEOUT_SECONDS=90
OPENAI_MAX_OUTPUT_TOKENS=3000
OPENAI_REASONING_EFFORT=low
REFRESH_INTERVAL_SECONDS=30
FUTURE_PROVIDER_NOTE=OpenAI is the preferred interpretation provider. Local calculations build and validate the evidence baseline; deterministic local rules are the final fallback. Qwen is reserved as a future provider slot.
MARKET_EXPLORER_RESULT_SCHEMA_VERSION=market-explorer.v1
# The market explorer has its own model setting so other backend features do not
# accidentally change its quality/latency profile.
OPENAI_MARKET_EXPLORER_MODEL=gpt-5.6-sol
# Optional dedicated model for non-blocking instrument-tab interpretation.
# OPENAI_INSTRUMENT_MODEL=gpt-5.6-sol
# Optional dedicated model for the Advanced Trading timing overlay.
# OPENAI_ADVANCED_TRADING_MODEL=gpt-5.6-sol
# REDIS_URL=redis://localhost:6379/0

# Optional. Used only if you add a NewsAPI integration later.
NEWSAPI_KEY=

# Optional Kaggle support:
# 1. Install optional deps: pip install -e ".[kaggle]"
# 2. Put kaggle.json under ~/.kaggle/kaggle.json or export these:
KAGGLE_USERNAME=
KAGGLE_KEY=
# Holiday ingestion (Nager.Date-compatible endpoint)
PUBLIC_HOLIDAY_COUNTRIES=CA,US
PUBLIC_HOLIDAY_SOURCE_URL=https://date.nager.at/api/v3/PublicHolidays/{year}/{country}
PUBLIC_HOLIDAY_SYNC_YEARS=2

# Optional external alert delivery
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
